# ------------------------------------------------------------------
# Bloom environment configuration.
#
# Copy this file to `.env` (same folder, repo root) and fill in real values.
# `.env` is gitignored and must never be committed. Only this example is tracked.
# ------------------------------------------------------------------


# ------------------------------------------------------------------
# Model selection.
#
# Each role is passed straight to LangChain's init_chat_model, so the value is
# "<provider>:<model>". Leave a line commented out to use the code default shown
# beside it. Swapping a model is just editing the string here — no code changes.
#
# Providers: ollama: | google_genai: | openai: | anthropic:
# ------------------------------------------------------------------

# Tier 3 defense examiner            (default: ollama:qwen3-coder:30b)
# EXAMINER_MODEL=ollama:qwen3-coder:30b

# Pass/fail verdict judge            (default: ollama:qwen3-coder:30b)
# JUDGE_MODEL=ollama:qwen3-coder:30b

# Curriculum skeleton generator      (default: google_genai:gemini-2.5-flash)
# CURRICULUM_MODEL=google_genai:gemini-2.5-flash

# Study-guide generator              (default: google_genai:gemini-2.5-flash)
# STUDY_MODEL=google_genai:gemini-2.5-flash

# Tier 1/2 exam question generator    (default: ollama:qwen3-coder:30b)
# QUESTION_MODEL=ollama:qwen3-coder:30b

# Tier 1/2 exam answer grader         (default: ollama:qwen3-coder:30b)
# GRADER_MODEL=ollama:qwen3-coder:30b


# ------------------------------------------------------------------
# API keys.
#
# Only the providers you actually use need a key. Ollama runs locally and needs
# no key (just a running `ollama serve` with the model pulled).
# ------------------------------------------------------------------
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=


# ------------------------------------------------------------------
# Mock mode.
#
# When true, /api/build-pathway and /api/study return the read-only sample
# fixtures in project_dictionary instead of calling a model. Lets you build and
# click through the whole frontend with zero tokens and no API keys. Leave unset
# (or false) to run the real engines.
# ------------------------------------------------------------------
# USE_MOCK=false
